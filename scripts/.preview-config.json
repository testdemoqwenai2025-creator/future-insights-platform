{
  "preview": {
    "defaultMode": "auto",
    "options": {
      "ide": {
        "enabled": true,
        "portRange": [3000, 3100],
        "description": "Local IDE/Studio pane preview"
      },
      "github": {
        "enabled": true,
        "defaultRepoName": "aeth-1-preview",
        "description": "GitHub Pages - permanent URL"
      }
    },
    "fallbackBehavior": "automatic",
    "timeout": 120000
  },
  "github": {
    "tokenEnvVar": "GITHUB_TOKEN",
    "defaultBranch": "main",
    "pagesBuildType": "legacy"
  },
  "output": {
    "showSummary": true,
    "copyUrlToClipboard": false,
    "openBrowser": false
  },
  "defaults": {
    "sourceFile": "./download/AETH-1-FULL-APPLICATION.html",
    "privateRepoName": "future-insights-platform",
    "publicPreviewRepoName": "aeth-1-preview"
  }
}
