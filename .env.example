# =============================================================================
# AETH-1 Platform - Environment Variables Template
# =============================================================================
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to version control!
#
# Usage:
#   cp .env.example .env.local
#   # Edit .env.local with your actual values
# =============================================================================

# -----------------------------------------------------------------------------
# Application Settings
# -----------------------------------------------------------------------------

# Node environment (development, test, production)
NODE_ENV=development

# Application URL (used for generating absolute URLs)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# Disable Next.js telemetry (recommended for CI)
NEXT_TELEMETRY_DISABLED=1

# -----------------------------------------------------------------------------
# Authentication & Security
# -----------------------------------------------------------------------------

# JWT Secret for token signing (generate with: openssl rand -base64 32)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-min-32-chars

# NextAuth.js secret (generate with: openssl rand -base64 32)
NEXTAUTH_SECRET=your-nextauth-secret-change-this-in-production-min-32-chars

# NextAuth URL (must match your app URL)
NEXTAUTH_URL=http://localhost:3000

# Optional: OAuth providers configuration
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------

# Prisma/Database connection string
# SQLite (default for development):
DATABASE_URL="file:./dev.db"

# PostgreSQL (for production/staging):
# DATABASE_URL="postgresql://user:password@localhost:5432/aeth1?schema=public"

# MySQL (alternative):
# DATABASE_URL="mysql://user:password@localhost:3306/aeth1"

# -----------------------------------------------------------------------------
# External Service APIs
# -----------------------------------------------------------------------------

# AI/ML Services (if applicable)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Search/External Data (if applicable)
# TAVILY_API_KEY=
# SERP_API_KEY=

# Storage (for file uploads)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# AWS_S3_BUCKET=aeth1-uploads

# -----------------------------------------------------------------------------
# Feature Flags
# -----------------------------------------------------------------------------

# Enable/disable features
ENABLE_ANALYTICS=true
ENABLE_COLLABORATION=false
ENABLE_STREAMING=false
ENABLE_ML_PIPELINE=false

# -----------------------------------------------------------------------------
# Notification Services (Optional)
# -----------------------------------------------------------------------------

# Slack webhook for CI/CD notifications
SLACK_WEBHOOK_URL=

# Discord webhook for CI/CD notifications
DISCORD_WEBHOOK_URL=

# Email service (for notifications)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# EMAIL_FROM=noreply@aeth1.app

# -----------------------------------------------------------------------------
# Monitoring & Observability
# -----------------------------------------------------------------------------

# Sentry (error tracking)
# SENTRY_DSN=

# Log level (trace, debug, info, warn, error, fatal)
LOG_LEVEL=info

# Enable verbose logging in development
DEBUG_MODE=true

# -----------------------------------------------------------------------------
# Rate Limiting & Security
# -----------------------------------------------------------------------------

# API rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# CORS settings (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# -----------------------------------------------------------------------------
# Cache Configuration
# -----------------------------------------------------------------------------

# Redis (optional, for caching/sessions)
# REDIS_URL=redis://localhost:6379

# Cache TTL (in seconds)
CACHE_TTL=3600

# -----------------------------------------------------------------------------
# Vercel Deployment (Set in Vercel dashboard, not here)
# -----------------------------------------------------------------------------
# These are documented for reference - set them in Vercel's env vars UI:
#
# VERCEL_TOKEN          - API token for GitHub Actions deployment
# VERCEL_ORG_ID         - Organization ID
# VERCEL_PROJECT_ID     - Project ID
#
# Production database URL (set as secret):
# PRODUCTION_DATABASE_URL=file:./prod.db
#
# Staging database URL (set as secret):
# STAGING_DATABASE_URL=file:./staging.db

# -----------------------------------------------------------------------------
# CI/CD Specific (Auto-set by GitHub Actions, don't set manually)
# -----------------------------------------------------------------------------
CI=false
GITHUB_RUN_ID=
GITHUB_SHA=
GITHUB_REF=
GITHUB_REPOSITORY=

# =============================================================================
# Environment-Specific Examples
# =============================================================================

# --- Development (.env.development) ---
# NODE_ENV=development
# DATABASE_URL="file:./dev.db"
# DEBUG_MODE=true
# LOG_LEVEL=debug

# --- Test (.env.test) ---
# NODE_ENV=test
# DATABASE_URL="file:./test.db"
# JWT_SECRET=test-secret-for-testing-only
# NEXTAUTH_SECRET=test-nextauth-secret
# NEXT_TELEMETRY_DISABLED=1

# --- Production (.env.production) ---
# NODE_ENV=production
# DATABASE_URL="postgresql://user:pass@db.example.com:5432/aeth1_prod"
# NEXT_PUBLIC_APP_URL=https://aeth-1.vercel.app
# DEBUG_MODE=false
# LOG_LEVEL=warn
# ENABLE_ANALYTICS=true

# =============================================================================
# Security Checklist
# =============================================================================
# Before deploying to production, ensure you have:
#
# [ ] Changed all default secrets/passwords
# [ ] Generated strong random secrets (32+ characters)
# [ ] Set up proper database credentials
# [ ] Configured CORS for your domain only
# [ ] Enabled HTTPS (automatic on Vercel)
# [ ] Set up monitoring/alerting
# [ ] Reviewed all feature flags
# [ ] Tested with production-like data
# [ ] Set up backup strategy for database
# [ ] Configured rate limiting appropriately
# [ ] Added all required API keys
# [ ] Reviewed and removed any debug settings
# =============================================================================
