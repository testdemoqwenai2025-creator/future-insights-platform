{"$schema": "https://openapi.vercel.sh/vercel.json", "framework": "nextjs", "buildCommand": "npm run build", "outputDirectory": ".next", "installCommand": "npm install", "devCommand": "npm run dev -- -p 3000", "regions": ["iad1", "hnd1"], "env": {"NEXT_PUBLIC_APP_URL": "https://aeth-1.vercel.app", "NODE_ENV": "production"}, "functions": {"src/app/api/**/*.ts": {"maxDuration": 30, "memory": 1024}, "src/app/api/data/**/*.ts": {"maxDuration": 60, "memory": 2048}, "src/app/api/storage/**/*.ts": {"maxDuration": 60, "memory": 2048}}, "headers": [{"source": "/api/(.*)", "headers": [{"key": "Access-Control-Allow-Origin", "value": "*"}, {"key": "Access-Control-Allow-Methods", "value": "GET, POST, PUT, DELETE, OPTIONS"}, {"key": "Access-Control-Allow-Headers", "value": "Content-Type, Authorization, X-API-Key"}]}, {"source": "/(.*)", "headers": [{"key": "X-Content-Type-Options", "value": "nosniff"}, {"key": "X-Frame-Options", "value": "DENY"}, {"key": "X-XSS-Protection", "value": "1; mode=block"}]}], "rewrites": [{"source": "/api/status", "destination": "/api/status"}]}